{
  "name": "customer-360-cockpit",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Customer 360 relationship cockpit — worklist-first React rebuild, built to one self-contained cockpit.html.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/rename-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contrast": "node scripts/contrast-check.mjs",
    "release:artifact": "node scripts/release-artifact.mjs",
    "gate:drives": "node ../design/probes/gate.mjs"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.6",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "jsdom": "25.0.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vite-plugin-singlefile": "2.2.0",
    "vitest": "2.1.9"
  }
}
